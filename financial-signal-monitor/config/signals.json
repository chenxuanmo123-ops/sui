{
  "signals": [
    {
      "id": "price_surge",
      "name": "价格异动",
      "description": "单日涨跌幅超过阈值",
      "params": {
        "threshold_percent": 5.0
      },
      "enabled": true
    },
    {
      "id": "volume_spike",
      "name": "成交量放大",
      "description": "成交量较前5日均量放大2倍以上",
      "params": {
        "multiple": 2.0,
        "lookback_days": 5
      },
      "enabled": true
    },
    {
      "id": "fund_inflow",
      "name": "主力资金流入",
      "description": "当日主力资金净流入超过1亿元",
      "params": {
        "min_inflow_cny": 100000000
      },
      "enabled": true
    },
    {
      "id": "macd_golden_cross",
      "name": "MACD金叉",
      "description": "MACD指标出现金叉信号",
      "params": {},
      "enabled": true
    }
  ],
  "note": "信号触发条件配置，threshold_percent: 涨跌幅阈值(%), multiple: 成交量倍数, min_inflow_cny: 最小资金流入(分)"
}
