{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/handover-context.mjs\" --session-start",
            "timeout": 15,
            "statusMessage": "读取交接文档状态"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/handover-context.mjs\"",
            "timeout": 15,
            "statusMessage": "检查交接文档是否到期"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/handover-snapshot.mjs\"",
            "timeout": 20,
            "statusMessage": "写入上下文快照"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/handover-snapshot.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
