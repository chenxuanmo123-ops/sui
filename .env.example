# 将本文件复制为 .env，填写真实配置。不要把密钥加入 Git，不使用 VITE_ 前缀。
# 填写到 /v1 的 OpenAI 兼容服务地址，程序会追加 /chat/completions。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER_NAME=我的分析模型
# 如供应商不支持 response_format，则设为 false；本地仍验证 JSON。
LLM_JSON_MODE=true

# 可选：同时配置多个供应商。启用后覆盖上方单模型配置，页面可选择。
# LLM_PROVIDERS_JSON='[{"id":"provider-a","name":"分析模型 A","baseURL":"https://your-provider.example/v1","apiKey":"填真实密钥","model":"填真实模型名","jsonMode":true}]'
# 本机保持 127.0.0.1；云端/容器设为 0.0.0.0，PORT 使用平台分配值。
HOST=127.0.0.1
PORT=5173

# 公网访问者自填 API 时允许的服务商域名（精确匹配，逗号分隔；无协议/路径）
# 本机 localhost/127.0.0.1 访问无需此项。公网自填接口只允许 HTTPS。
LLM_ALLOWED_HOSTS=

# 网页保存的默认模型与连接默认写入 .local/model-connections.json（密钥明文，仅本机）。
# 该目录已排除 Git；不要随代码公开或打包。环境变量连接仍为网页只读。

# Cloudflare Pages：在项目 Settings → Environment variables 填写上面同名的 LLM_* 变量。
# Pages Functions 没有本机文件系统，网页端保存/删除连接在公网返回 403，属预期行为；
# 需要让访客自带密钥时，把 LLM_ALLOWED_HOSTS 设为精确域名（逗号分隔）。
